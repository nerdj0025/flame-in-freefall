# Copy this file to ".env" (same folder) and edit. Lines starting with # are ignored.

# --- which AI answers the chat -------------------------------------------------
# auto   : FF_AI_URL set -> use the Colab server; else the new model locally if installed; else the old engine
# remote : always use FF_AI_URL      local : run the new model inside this backend      legacy : old engine
FF_AI_MODE=auto

# URL printed by colab/serve_in_colab.py (changes every Colab session). Leave empty to skip.
FF_AI_URL=

# Used to sign login tokens. Any long random text.
# FF_SECRET=
